# Copy to .env and edit. Never commit .env.
#
# Web login. Generate a password with:  openssl rand -base64 24
YT2ABS_WEB_USERNAME=admin
YT2ABS_WEB_PASSWORD=change-me

# Optional bearer token for API/automation. Generate: openssl rand -hex 24
# YT2ABS_WEB_TOKEN=

# Default Audiobookshelf tags for every book (comma-separated). Prefills the
# web form; clear the field per job to omit them.
YT2ABS_TAGS=YouTube

# Host path to your Audiobookshelf audiobook library (or a drop folder).
AUDIOBOOKS_DIR=/path/to/audiobooks

# Match the owner of that directory if it is not uid/gid 1000.
PUID=1000
PGID=1000

# Optional: trigger an Audiobookshelf library scan after every book.
# ABS_URL=http://audiobookshelf:80
# ABS_TOKEN=
# ABS_LIBRARY_ID=
